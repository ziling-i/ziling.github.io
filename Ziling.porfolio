<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chan Zi Ling — Business Analyst</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#16202A;
    --paper:#EFEEE9;
    --paper-dim:#E4E2DA;
    --steel:#3E6C8C;
    --moss:#5B7553;
    --amber:#C98A2B;
    --line:#C9C4B8;
    --white:#FAFAF7;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.5;
    overflow-x:hidden;
  }
  ::selection{background:var(--amber);color:var(--white);}
  a{color:inherit;text-decoration:none;}

  .mono{font-family:'JetBrains Mono',monospace;}

  /* focus visibility */
  a:focus-visible, button:focus-visible{
    outline:2px solid var(--steel);
    outline-offset:3px;
  }

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; scroll-behavior:auto !important;}
  }

  /* ---------- NAV ---------- */
  nav{
    position:fixed;top:0;left:0;right:0;
    display:flex;justify-content:space-between;align-items:center;
    padding:22px 6vw;
    z-index:100;
    background:rgba(239,238,233,0.85);
    backdrop-filter:blur(8px);
    border-bottom:1px solid var(--line);
  }
  .nav-mark{
    font-family:'JetBrains Mono',monospace;
    font-size:13px;
    letter-spacing:0.05em;
    color:var(--steel);
  }
  .nav-links{display:flex;gap:32px;font-size:14px;font-weight:500;}
  .nav-links a{position:relative;padding-bottom:2px;}
  .nav-links a::after{
    content:'';position:absolute;left:0;bottom:-2px;width:0;height:1px;
    background:var(--amber);transition:width .25s ease;
  }
  .nav-links a:hover::after{width:100%;}
  .nav-links{display:flex;}
  @media(max-width:700px){ .nav-links{display:none;} }

  section{padding:120px 6vw;max-width:1180px;margin:0 auto;}

  /* ---------- HERO ---------- */
  .hero{
    min-height:100vh;
    display:grid;
    grid-template-columns:1.1fr 0.9fr;
    align-items:center;
    gap:60px;
    padding-top:80px;
  }
  @media(max-width:900px){ .hero{grid-template-columns:1fr;min-height:auto;padding-top:140px;} }

  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:12.5px;
    letter-spacing:0.08em;
    color:var(--steel);
    text-transform:uppercase;
    display:flex;align-items:center;gap:10px;
    margin-bottom:22px;
    opacity:0;
    animation:riseIn .7s ease forwards .1s;
  }
  .eyebrow::before{
    content:'';width:22px;height:1px;background:var(--amber);
  }
  h1.name{
    font-family:'Instrument Serif',serif;
    font-size:clamp(48px,6.5vw,86px);
    font-weight:400;
    line-height:0.98;
    letter-spacing:-0.01em;
    margin-bottom:20px;
    opacity:0;
    animation:riseIn .8s ease forwards .25s;
  }
  h1.name em{color:var(--steel);font-style:italic;}
  .role-line{
    font-size:19px;
    color:#4A5560;
    max-width:480px;
    margin-bottom:34px;
    opacity:0;
    animation:riseIn .8s ease forwards .4s;
  }
  .role-line strong{color:var(--ink);font-weight:600;}
  .hero-cta{
    display:flex;gap:14px;flex-wrap:wrap;
    opacity:0;
    animation:riseIn .8s ease forwards .55s;
  }
  .btn{
    font-family:'Inter',sans-serif;
    font-size:14px;font-weight:600;
    padding:13px 24px;
    border-radius:2px;
    cursor:pointer;
    transition:all .2s ease;
    border:1px solid var(--ink);
  }
  .btn-primary{background:var(--ink);color:var(--paper);}
  .btn-primary:hover{background:var(--steel);border-color:var(--steel);}
  .btn-ghost{background:transparent;color:var(--ink);}
  .btn-ghost:hover{background:var(--ink);color:var(--paper);}

  @keyframes riseIn{
    from{opacity:0;transform:translateY(14px);}
    to{opacity:1;transform:translateY(0);}
  }

  /* signature chart element */
  .chart-card{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:3px;
    padding:26px 26px 20px;
    position:relative;
    opacity:0;
    animation:riseIn .9s ease forwards .5s;
  }
  .chart-head{
    display:flex;justify-content:space-between;align-items:baseline;
    margin-bottom:6px;
    font-family:'JetBrains Mono',monospace;
    font-size:11.5px;
    color:#7A756A;
  }
  .chart-head .val{
    font-size:26px;color:var(--ink);font-weight:600;font-family:'Inter',sans-serif;
  }
  .chart-head .delta{color:var(--moss);font-weight:600;}
  svg.line-chart{width:100%;height:150px;display:block;}
  .line-path{
    stroke:var(--steel);
    stroke-width:2.2;
    fill:none;
    stroke-dasharray:520;
    stroke-dashoffset:520;
    animation:draw 1.8s cubic-bezier(.65,0,.35,1) forwards .9s;
  }
  .area-path{fill:url(#areaGrad);opacity:0;animation:fadeArea 1s ease forwards 1.6s;}
  @keyframes draw{to{stroke-dashoffset:0;}}
  @keyframes fadeArea{to{opacity:1;}}
  .dot{
    fill:var(--amber);
    opacity:0;
    animation:popDot .4s ease forwards 2.5s;
  }
  @keyframes popDot{ to{opacity:1;} }
  .chart-labels{
    display:flex;justify-content:space-between;
    font-family:'JetBrains Mono',monospace;
    font-size:10.5px;color:#9A9587;
    margin-top:4px;
  }

  /* ---------- SECTION LABEL ---------- */
  .section-label{
    display:flex;align-items:center;gap:14px;
    margin-bottom:50px;
  }
  .section-label .cell{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;color:var(--steel);
    border:1px solid var(--line);
    background:var(--white);
    padding:3px 8px;
    border-radius:2px;
  }
  .section-label h2{
    font-family:'Instrument Serif',serif;
    font-size:clamp(30px,4vw,42px);
    font-weight:400;
  }
  .section-label .rule{flex:1;height:1px;background:var(--line);}

  /* ---------- ABOUT ---------- */
  .about-grid{
    display:grid;grid-template-columns:1fr 1fr;gap:60px;
  }
  @media(max-width:800px){.about-grid{grid-template-columns:1fr;}}
  .about-text p{font-size:16.5px;color:#3A4249;margin-bottom:18px;max-width:52ch;}
  .stat-block{
    display:grid;grid-template-columns:1fr 1fr;gap:1px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .stat{
    background:var(--white);
    padding:26px 22px;
  }
  .stat .num{
    font-family:'Instrument Serif',serif;
    font-size:38px;color:var(--steel);
  }
  .stat .label{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;color:#7A756A;
    margin-top:6px;
    letter-spacing:0.02em;
  }

  /* ---------- EXPERIENCE (timeline w/ cell refs) ---------- */
  .timeline{border-top:1px solid var(--line);}
  .trow{
    display:grid;
    grid-template-columns:90px 1fr 200px;
    gap:24px;
    padding:30px 0;
    border-bottom:1px solid var(--line);
    transition:background .2s ease;
  }
  .trow:hover{background:var(--paper-dim);}
  @media(max-width:750px){
    .trow{grid-template-columns:1fr;gap:8px;}
  }
  .tref{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;color:var(--amber);
    padding-top:3px;
  }
  .trole{font-size:18px;font-weight:600;margin-bottom:6px;}
  .tco{color:var(--steel);font-weight:500;}
  .tdesc{color:#4A5560;font-size:15px;max-width:60ch;margin-top:6px;}
  .tdate{
    font-family:'JetBrains Mono',monospace;
    font-size:12.5px;color:#8A8578;
    text-align:right;
    padding-top:3px;
  }
  @media(max-width:750px){ .tdate{text-align:left;} }

  /* ---------- SKILLS (pivot table style) ---------- */
  .pivot{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .pivot-group{background:var(--white);padding:26px 24px;}
  .pivot-group h3{
    font-family:'JetBrains Mono',monospace;
    font-size:11.5px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--steel);
    margin-bottom:16px;
    padding-bottom:10px;
    border-bottom:1px solid var(--paper-dim);
  }
  .pivot-group ul{list-style:none;}
  .pivot-group li{
    font-size:14.5px;
    padding:6px 0;
    display:flex;justify-content:space-between;
    color:#3A4249;
  }
  .pivot-group li .bar{
    width:60px;height:5px;background:var(--paper-dim);
    position:relative;border-radius:2px;overflow:hidden;align-self:center;
  }
  .pivot-group li .bar::after{
    content:'';position:absolute;left:0;top:0;bottom:0;
    background:var(--moss);
    width:var(--w);
  }

  /* ---------- PROJECTS ---------- */
  .projects{
    display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
    background:var(--line);border:1px solid var(--line);
  }
  @media(max-width:900px){.projects{grid-template-columns:1fr;}}
  .pcard{
    background:var(--white);
    padding:32px 26px;
    display:flex;flex-direction:column;
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .pcard:hover{
    transform:translateY(-4px);
    box-shadow:0 14px 30px -18px rgba(22,32,42,0.35);
    z-index:2;
  }
  .pcard .tag{
    font-family:'JetBrains Mono',monospace;
    font-size:11px;color:var(--amber);
    margin-bottom:14px;
  }
  .pcard h3{font-size:19px;margin-bottom:10px;font-weight:600;}
  .pcard p{font-size:14.5px;color:#4A5560;flex:1;margin-bottom:18px;}
  .pcard .impact{
    font-family:'JetBrains Mono',monospace;
    font-size:12.5px;
    color:var(--moss);
    border-top:1px solid var(--paper-dim);
    padding-top:14px;
  }

  /* ---------- CONTACT ---------- */
  .contact{
    background:var(--ink);
    color:var(--paper);
    border-radius:4px;
    padding:70px 6vw;
    text-align:center;
  }
  .contact h2{
    font-family:'Instrument Serif',serif;
    font-size:clamp(32px,5vw,52px);
    font-weight:400;
    margin-bottom:18px;
  }
  .contact p{color:#B9BFC4;margin-bottom:34px;font-size:16px;}
  .contact-links{
    display:flex;gap:18px;justify-content:center;flex-wrap:wrap;
  }
  .contact-links a{
    font-family:'JetBrains Mono',monospace;
    font-size:13.5px;
    border:1px solid #3A4750;
    padding:11px 20px;
    border-radius:2px;
    transition:all .2s ease;
  }
  .contact-links a:hover{
    border-color:var(--amber);color:var(--amber);
  }

  footer{
    text-align:center;
    padding:36px 6vw 50px;
    font-family:'JetBrains Mono',monospace;
    font-size:11.5px;
    color:#8A8578;
  }

  /* scroll reveal */
  .reveal{opacity:0;transform:translateY(24px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.in{opacity:1;transform:translateY(0);}
</style>
</head>
<body>

<nav>
  <div class="nav-mark">CZL / analyst</div>
  <div class="nav-links">
    <a href="#about">About</a>
    <a href="#experience">Experience</a>
    <a href="#skills">Skills</a>
    <a href="#projects">Projects</a>
    <a href="#contact">Contact</a>
  </div>
</nav>

<!-- HERO -->
<section class="hero" id="top">
  <div>
    <div class="eyebrow">Kuala Lumpur, Malaysia</div>
    <h1 class="name">Chan Zi Ling,<br><em>Business Analyst</em></h1>
    <p class="role-line">I translate <strong>business needs into working systems</strong> — writing BRDs and URDs, mapping processes, and validating that what gets built actually matches what was asked for.</p>
    <div class="hero-cta">
      <a href="#projects" class="btn btn-primary">View case studies</a>
      <a href="#contact" class="btn btn-ghost">Get in touch</a>
    </div>
  </div>

  <div class="chart-card">
    <div class="chart-head">
      <span>MANUAL REPORTING TIME</span>
      <span class="val">-30% <span class="delta">▲</span></span>
    </div>
    <svg class="line-chart" viewBox="0 0 400 150" preserveAspectRatio="none">
      <defs>
        <linearGradient id="areaGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#3E6C8C" stop-opacity="0.22"/>
          <stop offset="100%" stop-color="#3E6C8C" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <path class="area-path" d="M0,120 L40,110 L80,118 L120,95 L160,100 L200,70 L240,78 L280,50 L320,55 L360,25 L400,30 L400,150 L0,150 Z"/>
      <path class="line-path" d="M0,120 L40,110 L80,118 L120,95 L160,100 L200,70 L240,78 L280,50 L320,55 L360,25 L400,30"/>
      <circle class="dot" cx="400" cy="30" r="4.5"/>
    </svg>
    <div class="chart-labels">
      <span>Q1</span><span>Q2</span><span>Q3</span><span>Q4</span>
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="section-label">
    <span class="cell mono">A1</span>
    <h2>About</h2>
    <div class="rule"></div>
  </div>
  <div class="about-grid">
    <div class="about-text reveal">
      <p>I'm a business analyst working in fintech, currently at Rakuten Trade, where I sit between business stakeholders and engineering teams on mobile trading application enhancements. I turn ambiguous requests into clear BRDs, URDs, and functional specs that both sides can build against.</p>
      <p>I've supported enterprise UAT across projects like Multi-Factor Authentication, ICE Migration, and SDK testing — validating that what ships actually matches what was requested, down to the UI.</p>
      <p>I hold a Bachelor's in Information Technology (Business Analytics) from INTI International University, dual-awarded with Coventry University, UK.</p>
    </div>
    <div class="stat-block reveal">
      <div class="stat"><div class="num">5+</div><div class="label">DASHBOARDS BUILT</div></div>
      <div class="stat"><div class="num">30%</div><div class="label">MANUAL WORK REDUCED</div></div>
      <div class="stat"><div class="num">3</div><div class="label">ENTERPRISE UAT PROJECTS</div></div>
      <div class="stat"><div class="num">75%</div><div class="label">ML MODEL ACCURACY</div></div>
    </div>
  </div>
</section>

<!-- EXPERIENCE -->
<section id="experience">
  <div class="section-label">
    <span class="cell mono">B1</span>
    <h2>Experience</h2>
    <div class="rule"></div>
  </div>
  <div class="timeline reveal">
    <div class="trow">
      <div class="tref">B2</div>
      <div>
        <div class="trole">Business Analyst — <span class="tco">Rakuten Trade SDN BHD</span></div>
        <div class="tdesc">Gather business and user requirements for mobile trading app enhancements. Produce BRDs, URDs, and UI Design Documents to align business objectives with technical implementation. Participated in UAT for MFA, ICE Migration, and SDK testing, and performed UI validation against approved specs.</div>
      </div>
      <div class="tdate">Oct 2025 — Present</div>
    </div>
    <div class="trow">
      <div class="tref">B3</div>
      <div>
        <div class="trole">Business Analyst (Internship) — <span class="tco">C.I.E.F Worldwide SDN BHD</span></div>
        <div class="tdesc">Built 5+ interactive Lark dashboards tracking gross profit, sales performance, and payment methods to support faster management decisions. Automated daily sales reporting with Excel formulas, cutting manual work by 30%. Identified UX/UI issues on payment and shipping websites and improved site content via WordPress.</div>
      </div>
      <div class="tdate">Jan 2025 — Apr 2025</div>
    </div>
    <div class="trow">
      <div class="tref">B4</div>
      <div>
        <div class="trole">B.IT (Hons), Business Analytics — <span class="tco">INTI International University</span></div>
        <div class="tdesc">Dual award with Coventry University, United Kingdom. Coursework and final year project centered on business analytics, data-driven decision making, and applied machine learning.</div>
      </div>
      <div class="tdate">Jun 2022 — Jan 2025</div>
    </div>
  </div>
</section>

<!-- SKILLS -->
<section id="skills">
  <div class="section-label">
    <span class="cell mono">C1</span>
    <h2>Skills</h2>
    <div class="rule"></div>
  </div>
  <div class="pivot reveal">
    <div class="pivot-group">
      <h3>Business Analysis</h3>
      <ul>
        <li>Requirement gathering <span class="bar" style="--w:92%"></span></li>
        <li>BRD / URD / UIDD <span class="bar" style="--w:90%"></span></li>
        <li>Process flow docs <span class="bar" style="--w:85%"></span></li>
        <li>UAT <span class="bar" style="--w:88%"></span></li>
      </ul>
    </div>
    <div class="pivot-group">
      <h3>Data &amp; Visualization</h3>
      <ul>
        <li>Power BI <span class="bar" style="--w:80%"></span></li>
        <li>Tableau <span class="bar" style="--w:78%"></span></li>
        <li>SQL <span class="bar" style="--w:75%"></span></li>
        <li>Excel automation <span class="bar" style="--w:88%"></span></li>
      </ul>
    </div>
    <div class="pivot-group">
      <h3>Digital &amp; Tools</h3>
      <ul>
        <li>Figma <span class="bar" style="--w:75%"></span></li>
        <li>WordPress <span class="bar" style="--w:65%"></span></li>
        <li>Lark <span class="bar" style="--w:80%"></span></li>
        <li>Android Studio <span class="bar" style="--w:55%"></span></li>
      </ul>
    </div>
    <div class="pivot-group">
      <h3>Technical (Supporting)</h3>
      <ul>
        <li>Python <span class="bar" style="--w:65%"></span></li>
        <li>Java <span class="bar" style="--w:55%"></span></li>
        <li>PHP <span class="bar" style="--w:50%"></span></li>
        <li>C++ <span class="bar" style="--w:45%"></span></li>
      </ul>
    </div>
  </div>
</section>

<!-- PROJECTS -->
<section id="projects">
  <div class="section-label">
    <span class="cell mono">D1</span>
    <h2>Case studies</h2>
    <div class="rule"></div>
  </div>
  <div class="projects reveal">
    <div class="pcard">
      <div class="tag">MACHINE LEARNING</div>
      <h3>Job Matching System Optimization</h3>
      <p>Final year project: designed a job recommendation system, evaluating multiple ML models and deploying the top performer with Python and Flask into a web app delivering real-time recommendations.</p>
      <div class="impact">↑ 75% match accuracy</div>
    </div>
    <div class="pcard">
      <div class="tag">UX / MOBILE</div>
      <h3>Public Bank Mobile App — Junior Mode</h3>
      <p>Designed a "Junior Mode" prototype in Figma to improve the mobile banking experience for youth users, then implemented it in Android Studio with a focus on accessibility and engagement.</p>
      <div class="impact">Prototype → working build</div>
    </div>
    <div class="pcard">
      <div class="tag">REPORTING</div>
      <h3>Sales dashboard automation</h3>
      <p>Built 5+ interactive Lark dashboards tracking gross profit, sales performance, and payment methods, and automated daily sales reporting with Excel formulas to cut manual work.</p>
      <div class="impact">↓ 30% manual reporting time</div>
    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="contact reveal">
    <h2>Let's talk numbers.</h2>
    <p>Open to business analyst and analytics roles — always happy to chat.</p>
    <div class="contact-links">
      <a href="mailto:nchen0219@gmail.com">nchen0219@gmail.com</a>
      <a href="tel:+601135179336">+60 11-3517 9336</a>
      <a href="#">LinkedIn</a>
    </div>
  </div>
</section>

<footer>
  © 2026 Chan Zi Ling — built with care, indexed by curiosity.
</footer>

<script>
  const revealEls = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if(e.isIntersecting){
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });
  revealEls.forEach(el => io.observe(el));
</script>

</body>
</html>
